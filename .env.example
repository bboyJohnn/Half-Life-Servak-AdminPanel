# Half-Life Web Panel settings. Copy this file to .env next to app.py and fill in the REQUIRED part:
#   cp .env.example .env && chmod 600 .env
# A value may refer to a key set above it in this file: ${HL_DIR}/server.cfg. Text after " #" is a comment.
# Relative paths start at the folder of this file. Empty value = the default shown in the comment.
# Check everything with:  python3 app.py --check

# ============================================================== REQUIRED

# The game folder of your dedicated server: the one with server.cfg, mapcycle.txt and maps/
# (for a Steam/SteamCMD install usually .../hlds/valve, for the old WON server .../hlds_l/valve).
HL_DIR=/home/hlds/hlds/valve

# Panel login password (scrypt hash) and the key that signs login cookies.
# Do not write them by hand — run:  python3 app.py --init   (random password)  or  python3 tools/passwd.py
PANEL_PASSWORD_HASH=
PANEL_SECRET=

# ============================================================== THE GAME SERVER

HL_HOST=127.0.0.1                # where the panel asks the server (info, players, rcon)
HL_PORT=27015
PUBLIC_ADDRESS=                  # what players type to connect, e.g. hl.example.org:27015 (shown on Overview)

# rcon password. Empty = read "rcon_password" from RCON_CFG (by default server.cfg).
RCON_PASSWORD=
RCON_CFG=                        # ${SERVER_CFG}

# Live log: the server sends every log line over UDP ("logaddress"), the panel listens and writes them
# to LIVE_LOG. Who is online, visits and statistics are built from it. In server.cfg put:
#   log on
#   logaddress 127.0.0.1 27500         (WON server)   or   logaddress_add 127.0.0.1 27500   (Steam server)
LOG_UDP=127.0.0.1:27500          # empty = do not listen (something else writes LIVE_LOG)
LIVE_LOG=                        # ${PANEL_DATA}/live.log

# ============================================================== NETWORK

# Where the panel listens. 127.0.0.1 = only this machine (open it through an SSH tunnel or a reverse proxy).
PANEL_HOST=127.0.0.1
PANEL_PORT=8093
# Who may connect at all (before the password): addresses and networks, comma separated.
# Behind nginx on the same machine keep 127.0.0.1. For a home network: 127.0.0.1,::1,192.168.0.0/24
PANEL_ALLOWED_PEERS=127.0.0.1,::1

# ============================================================== LOOK

PANEL_TITLE=                     # name in the menu and on the login screen; empty = the server's hostname
PANEL_HUB=                       # optional "All panels" link: a URL, or :8089 (same host, other port)

# ============================================================== FILES (defaults come from HL_DIR)

SERVER_CFG=                      # ${HL_DIR}/server.cfg — the "Server settings" page
MAPCYCLE=                        # ${HL_DIR}/mapcycle.txt — the panel rewrites it (see README, "Maps")
MAPPOOL=                         # ${PANEL_DATA}/mappool.txt — the panel's own map order (created on first save)
MAPS_DIRS=                       # ${HL_DIR}/maps — where the .bsp maps are; several folders comma separated
LISTIP_CFG=                      # ${HL_DIR}/listip.cfg — IP bans (written by the server's "writeip")
HLDS_LOGS=                       # ${HL_DIR}/logs — the server's own L*.log files (the Logs page)
PANEL_DATA=                      # ./data — panel database, map order, copies of edited files, live log
PASSWORD_FILE=                   # ${PANEL_DATA}/panel-password.txt — where --init saves the new password

# ============================================================== OPTIONAL
# Leave empty if you do not have it — the panel then simply hides the matching buttons and cards.

# Restart button. Server in Docker: the container name (also gives the container card, stop/start and
# "docker logs" as the console). Without Docker: a command that restarts the server, run as the panel's
# user, e.g. "pkill -x hlds_linux" when hlds_run or systemd (Restart=always) starts it again.
CONTAINER=
RESTART_CMD=
CONSOLE_LOG=                     # a file with the server's console output (Logs page, crash list on Overview)

# jk_botti bots: path to jk_botti.cfg — gives the bots card and bot settings.
BOTS_CFG=

# Country by IP: GeoLite2-Country.mmdb (free from MaxMind), needs "pip install maxminddb".
# Several paths comma separated — the first that exists is used.
GEOIP_DB=                        # ${PANEL_DATA}/GeoLite2-Country.mmdb
